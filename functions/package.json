{
  "name": "functions",
  "description": "Cloud Functions for DZN-Timme",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1",
    "date-fns": "^3.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.4.5"
  },
  "private": true
}
